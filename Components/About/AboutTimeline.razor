@using site.Services

@inject ThemeService ThemeService

<section class="about-timeline surface">

  <span class="about-timeline__label">
    Minha trajetória
  </span>

  <div class="about-timeline__wrapper">

    <button class="about-timeline__arrow" @onclick="Previous">
      <i class="fa-solid fa-chevron-left"></i>
    </button>

    <div class="about-timeline__viewport">

      <div class="about-timeline__track" style="transform:translateX(-@(CurrentIndex * CardWidth)px)">

        @foreach (var item in Timeline)
        {
          <div class="about-timeline__column">

            <div class="about-timeline__point">
              <span class="about-timeline__line-left"></span>
              <span class="about-timeline__dot"></span>
              <span class="about-timeline__line-right"></span>
            </div>

            <article class="about-timeline__card">

              <div class="about-timeline__icon">
                <i class="@item.Icon"></i>
              </div>

              <span class="about-timeline__year">
                @item.Year
              </span>

              <h3>@item.Title</h3>

              <small>@item.Subtitle</small>

              <p>@item.Description</p>

              <div class="about-timeline__image-wrap">
                <img src="@item.Image" />
              </div>

            </article>

          </div>
        }

      </div>

    </div>

    <button class="about-timeline__arrow" @onclick="Next">
      <i class="fa-solid fa-chevron-right"></i>
    </button>

  </div>

</section>

@code {

  private sealed class TimelineItem

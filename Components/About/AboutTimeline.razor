            Icon="fa-solid fa-graduation-cap",
            Image="/images/laboratoria_icon.jpg"
        },
        new TimelineItem
        {
            Year="maio/2021",
            Title="Reprograma",
            Subtitle="Curso",
            Description="Curso de imersão em JavaScript com foco em Backend.",
            Icon="fa-solid fa-graduation-cap",
            Image="/images/reprograma_banner.png"
        },
        new TimelineItem
        {

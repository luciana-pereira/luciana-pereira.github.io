    };

  private int CurrentIndex;

  private const int VisibleCards = 3;

  private const int CardWidth = 250;

  private int MaxIndex =>
      Math.Max(0, Timeline.Count - VisibleCards);

  private void Next()
  {
    if (CurrentIndex < MaxIndex)
      CurrentIndex++;
  }

  private void Previous()
  {
    if (CurrentIndex > 0)
      CurrentIndex--;
  }

}

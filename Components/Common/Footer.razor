@using site.Models
@using site.Services
@using site.Components.Common
@implements IDisposable
@inject ThemeService ThemeService

<footer class="footer">

    <div class="footer__container">

        <!-- Branding -->
        <div class="footer__brand">

            <NavLink href="/" class="nav__link" activeClass="active">
                <img src="@CurrentLogo" alt="Logo" class="logo" />
            </NavLink>

            <p class="footer__description">
                Engenheira de software full-stack apaixonada por
                arquitetura, cloud e plataformas modernas.
            </p>
            <div class="footer__location">
                <i class="fa-solid fa-location-dot"></i>
                <p>São Paulo, Brasil</p>
            </div>
            <SocialLinks CssClass="social__icons" Links="socialLinks" />
            <div class="footer__newsletter">

                <h5>Receba conteúdos</h5>

                <div class="footer__newsletter-form">

                    <input
                        type="email"
                        placeholder="Seu email" />

                    <button>
                        Inscrever
                    </button>

                </div>

            </div>
        </div>

        <!-- Conteúdo -->
        <div class="footer__links">

            <h5>Conteúdo</h5>

            <a href="#blog">Blog</a>
            <a href="#about">Sobre</a>
            <a href="/cursos">Cursos</a>
            <a href="#projects">Projetos</a>
            <a href="#experience">Experiência</a>

        </div>

        <!-- Contato -->
        <div class="footer__contact">

            <h5>Contato</h5>

            <div class="footer__mini-form">

                <input
                    type="email"
                    placeholder="Seu email" />

                <textarea
                    rows="3"
                    placeholder="Fale sobre seu projeto"></textarea>

                <button class="footer__button">
                    Enviar Mensagem
                </button>

            </div>            
            
            @* <button class="footer__button">
                Vamos Trabalhar Juntos
            </button> *@

        </div>

    </div>

    <!-- Bottom -->
    <div class="footer__bottom">

        <p>
            © 2026 Luciana Pereira.
            Todos os direitos reservados.
        </p>

        <a href="">Política de Privacidade</a>
        <a href="">Termos de Uso</a>

    </div>

</footer>

@code {
    private List<SocialLink> socialLinks = new List<SocialLink> ()
    {
        new SocialLink() { Url = "https://github.com/luciana-pereira", Icon = "fa-brands fa-github", Name = "GitHub" },
        new SocialLink() { Url = "https://www.linkedin.com/in/lucianapereiras/", Icon = "fa-brands fa-linkedin", Name = "LinkedIn" },
        new SocialLink() { Url = "https://wa.me/11982779387", Icon = "fa-brands fa-whatsapp", Name = "WhatsApp" },
        new SocialLink() { Url = "https://twitter.com/lupereiradev", Icon = "fa-brands fa-twitter", Name = "Twitter" },
        new SocialLink() { Url = "https://www.facebook.com/luciana.pereiras.35762241", Icon = "fa-brands fa-facebook", Name = "Facebook" },
        new SocialLink() { Url = "https://www.instagram.com/lucianapereiradev/", Icon = "fa-brands fa-instagram", Name = "Instagram" },
        new SocialLink() { Url = "https://www.youtube.com/channel/UC9Xo2l8n7s1m5j3v6k5z9w", Icon = "fa-brands fa-youtube", Name = "YouTube" },
    };

    private string CurrentLogo =>
        ThemeService.IsDarkMode
            ? "/images/White_Logo_1.png"
            : "/images/Black_Logo_1.png";

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += HandleThemeChanged;
    }

    private async void HandleThemeChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= HandleThemeChanged;
    }
}
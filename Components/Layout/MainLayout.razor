@inherits LayoutComponentBase
@using site.Services
@inject ThemeService ThemeService

<div class="page">
    <NavMenu />

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
    <Footer />
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeService.InitializeAsync();
            StateHasChanged();
        }
    }
}

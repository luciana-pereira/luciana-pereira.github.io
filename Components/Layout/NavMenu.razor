@using site.Enums
@using site.Services
@implements IDisposable
@inject ThemeService ThemeService

<nav class="navbar surface">
    <div class="navbar__brand">
        <NavLink href="/" class="nav__link navbar__logo-link" activeClass="active" aria-label="Ir para a home">
            <img src="@CurrentLogo" alt="Logo" class="logo" />
        </NavLink>
    </div>

    <div class="navbar-right">
        <button class="icon-button" @onclick="ToggleLanguage" aria-label="Alternar idioma">
            <Icon Name="IconType.Language"  />
        </button>

        <button class="icon-button" @onclick="ToggleTheme" aria-label="Alternar tema">
            <Icon Name="IconType.Theme"  />
        </button>

        <button class="icon-button" @onclick="GetInTouch" aria-label="Entrar em contato">
            <Icon Name="IconType.Email"  />
        </button>

        @if (showMobileMenu)
        {
            <button class="icon-button" @onclick="ToggleMobileMenu" aria-label="Fechar menu">
                <Icon Name="IconType.Close"  />
            </button>
        } else {
            <button class="icon-button hamburger" @onclick="ToggleMobileMenu" aria-label="Abrir menu">
                <Icon Name="IconType.Menu"  />
            </button>
        }
    </div>

    @if (showMobileMenu)
    {
        <div class="mobile__menu">
            <NavLink href="/" class="nav__link" activeClass="active">Inicio</NavLink>
            <NavLink href="/sobre" class="nav__link" activeClass="active">Sobre</NavLink>
            <NavLink href="/portfolio" class="nav__link" activeClass="active">Portfólio</NavLink>
            <NavLink href="/certificacoes" class="nav__link" activeClass="active">Certificações</NavLink>
            <NavLink href="/conteudo" class="nav__link" activeClass="active">Conteúdo</NavLink>
            <NavLink href="/blog" class="nav__link" activeClass="active">Blog</NavLink>
            <NavLink href="/cursos" class="nav__link" activeClass="active">Cursos</NavLink>
            <NavLink href="/contato" class="nav__link" activeClass="active">Contato</NavLink>
        </div>
    }
</nav>

@code {
    private bool showMobileMenu = false;

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += HandleThemeChanged;
    }

    private async void HandleThemeChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= HandleThemeChanged;
    }

    private void ToggleMobileMenu()
    {
        showMobileMenu = !showMobileMenu;
    }

    private async Task ToggleTheme()
    {
        await ThemeService.ToggleAsync();
    }

    private string CurrentLogo =>
        ThemeService.IsDarkMode
            ? "/images/White_Logo_1.png"
            : "/images/Black_Logo_1.png";

    private void ToggleLanguage()
    {
    }

    private void GetInTouch()
    {

    }
}



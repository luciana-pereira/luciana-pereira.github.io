{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "text-size-adjust",
          "mask-image"
        ]
      }
    ],
    "manifest-app-name": "off"
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not and_ff <= 140",
    "not firefox <= 140"
  ]
}
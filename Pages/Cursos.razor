@page "/cursos"

<FeaturedCarousel OnPreview="HandleCoursePreview" />

<div class="filters-bar filters-bar--top">
	<div class="filters-wrap">
		<select class="filter-select" @bind="selectedType">
			<option value="">Todos os tipos</option>
			@foreach (var ty in typeOptions) { <option value="@ty">@ty</option> }
		</select>

		<select class="filter-select" @bind="selectedFormat">
			<option value="">Todos os formatos</option>
			@foreach (var f in formatOptions) { <option value="@f">@f</option> }
		</select>

		<select class="filter-select" @bind="selectedLevel">
			<option value="">Todos os níveis</option>
			@foreach (var l in levelOptions) { <option value="@l">@l</option> }
		</select>

		<button type="button" class="btn btn--secondary" @onclick="ResetFilters">Limpar</button>
	</div>
</div>

<HomeCoursesPreview IsPreview="false" Courses="filteredCourses" ShowPlayerModal="showCourseModal" SelectedCourse="selectedCourse" OnPreview="HandleCoursePreview" ClosePreview="CloseCoursePreview" />

@using site.Data
@using site.Models

@code {
	private string selectedType = string.Empty;
	private string selectedFormat = string.Empty;
	private string selectedLevel = string.Empty;

	private IEnumerable<string> typeOptions = Array.Empty<string>();
	private IEnumerable<string> formatOptions = Array.Empty<string>();
	private IEnumerable<string> levelOptions = Array.Empty<string>();

	private bool showCourseModal;
	private CourseCardItem? selectedCourse;

	private IEnumerable<CourseCardItem> filteredCourses =>
		CourseRepository.Courses
			.Where(c => string.IsNullOrEmpty(selectedType) || c.Type == selectedType)
			.Where(c => string.IsNullOrEmpty(selectedFormat) || c.Format == selectedFormat)
			.Where(c => string.IsNullOrEmpty(selectedLevel) || c.Difficulty == selectedLevel)
			.ToList();

	protected override void OnInitialized()
	{
		typeOptions = CourseRepository.Courses.Select(c => c.Type).Distinct();
		formatOptions = CourseRepository.Courses.Select(c => c.Format).Distinct();
		levelOptions = CourseRepository.Courses.Select(c => c.Difficulty).Distinct();
	}

	private void ResetFilters()
	{
		selectedType = string.Empty;
		selectedFormat = string.Empty;
		selectedLevel = string.Empty;
	}

	private void HandleCoursePreview(CourseCardItem course)
	{
		selectedCourse = course;
		showCourseModal = true;
	}

	private void CloseCoursePreview()
	{
		showCourseModal = false;
		selectedCourse = null;
	}
}

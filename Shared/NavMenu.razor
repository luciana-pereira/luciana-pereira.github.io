<nav class="navbar">
    <img src="@logoSrc" alt="Logo" class="logo" />

    <div class="navbar-center desktop-menu">
        <a href="#portfolio">Portfólio</a>
        <a href="#blog">Blog</a>
        <a href="#cursos">Cursos</a>
        <a href="#perfil">Perfil</a>
    </div>

    <div class="navbar-right">
        <button class="icon-button" @onclick="ToggleLanguage">@((MarkupString)languageIcon)</button>
        <button class="icon-button" @onclick="ToggleTheme">🌙</button>
        <button class="icon-button">✉️</button>
        <button class="hamburger" @onclick="ToggleMobileMenu">☰</button>
    </div>

    @if (showMobileMenu)
    {
        <div class="mobile-menu">
            <a href="#portfolio">Portfólio</a>
            <a href="#blog">Blog</a>
            <a href="#cursos">Cursos</a>
            <a href="#perfil">Perfil</a>
        </div>
    }
</nav>


@code {
    private bool showMobileMenu = false;
    private string logoSrc = "/images/logo-black.png";
    private bool isDarkMode = false;
    private string languageIcon = @"<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='lucide lucide-languages h-3 w-3 mr-1' aria-hidden='true'><path d='m5 8 6 6'></path><path d='m4 14 6-6 2-3'></path><path d='M2 5h12'></path><path d='M7 2h1'></path><path d='m22 22-5-10-5 10'></path><path d='M14 18h6'></path></svg>";


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isDarkMode = await JS.InvokeAsync<bool>("detectDarkMode");
            UpdateVisuals();
            StateHasChanged();
        }
    }

    private void ToggleMobileMenu()
    {
        showMobileMenu = !showMobileMenu;
    }

    private void ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        UpdateVisuals();
    }

    private void UpdateVisuals()
    {
        logoSrc = isDarkMode
            ? "/images/logo-colorful.png"
            : "/images/logo-black.png";

        UpdateLanguageIcon();
    }

    private void UpdateLanguageIcon()
    {
        languageIcon = isDarkMode
            ? @"<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='lucide lucide-languages h-3 w-3 mr-1' aria-hidden='true'><path d='m5 8 6 6'></path><path d='m4 14 6-6 2-3'></path><path d='M2 5h12'></path><path d='M7 2h1'></path><path d='m22 22-5-10-5 10'></path><path d='M14 18h6'></path></svg>"
            : @"<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='lucide lucide-languages h-3 w-3 mr-1' aria-hidden='true'><path d='m5 8 6 6'></path><path d='m4 14 6-6 2-3'></path><path d='M2 5h12'></path><path d='M7 2h1'></path><path d='m22 22-5-10-5 10'></path><path d='M14 18h6'></path></svg>";
    }

    private void ToggleLanguage()
    {
        // Ainda não implementado
    }



    [Inject]
    private IJSRuntime JS { get; set; } = default!;
}



        <NavLink href="/projetos" class="nav__link" activeClass="active">Projetos</NavLink>
        <NavLink href="/habilidades" class="nav__link" activeClass="active">Habilidades</NavLink>
        <NavLink href="/certificados" class="nav__link" activeClass="active">Certificados</NavLink>
        <NavLink href="/blog" class="nav__link" activeClass="active">Blog</NavLink>
        <NavLink href="/cursos" class="nav__link" activeClass="active">Cursos</NavLink>
        <NavLink href="/contato" class="nav__link" activeClass="active">Contato</NavLink> *@
    
    
    

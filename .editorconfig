root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4

[*.{cshtml,razor}]
indent_size = 2

[*.{js,json,md,yml,yaml,scss,css,html}] 
indent_size = 2

[*.{xml,csproj,props,targets}]
indent_size = 2
